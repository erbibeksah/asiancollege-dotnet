@model IEnumerable<TestDotnet.Models.Students>;
@{
    ViewData["Title"] = "Student Page";
}
<h1>Student Page</h1>
<a asp-action="Create">Create</a>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Semester</th>
            <th>CGPA</th>
            <th>Package</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Name</td>
                <td>@student.Email</td>
                <td>@student.Semester</td>
                <td>@student.Cgpa</td>
                <td>@student.package</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@student.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@student.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>